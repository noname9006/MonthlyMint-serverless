# Discord OAuth2 Configuration
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Public Discord Client ID (for frontend)
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id_here

# WalletConnect Project ID (get one at https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Blockchain Network Selection
# Set NEXT_PUBLIC_NETWORK_ID to the chain ID of the network you want to use
# 3637 = Botanix Mainnet (default)
# 3636 = Botanix Testnet
# IMPORTANT: After changing this value, you MUST restart the dev server (npm run dev)
#            or rebuild (npm run build) for changes to take effect!
NEXT_PUBLIC_NETWORK_ID=3637

# NFT Contract Configuration (Single contract for all tokens)
# The new contract uses a single address for all NFT minting
NEXT_PUBLIC_NFT_CONTRACT_ADDRESS=your_nft_contract_address_here
BACKEND_PRIVATE_KEY=your_backend_wallet_private_key_here

# Admin Users (Discord User IDs - no limit on quantity)
# Add as many admin users as needed by incrementing the number
ADMIN1_USERID=your_discord_user_id_here
ADMIN2_USERID=another_discord_user_id_here
# ADMIN3_USERID=
# ADMIN4_USERID=

# Media CIDs for each level, year, and month (IPFS Content Identifiers)
# Format: NEXT_PUBLIC_{LEVEL}_{YEAR}_{MONTH}
# These replace the contract-stored media URIs from the old implementation
# Note: Store only the CID (hash), not the full ipfs:// URI

# Botanist Level Media CIDs
NEXT_PUBLIC_BOTANIST_2025_JAN=QmYourBotanistJan2025Hash
NEXT_PUBLIC_BOTANIST_2025_FEB=QmYourBotanistFeb2025Hash

# Hyperion Ambassador Level Media CIDs
NEXT_PUBLIC_HYPERION_2025_JAN=QmYourHyperionJan2025Hash
NEXT_PUBLIC_HYPERION_2025_FEB=QmYourHyperionFeb2025Hash

# Sequoia Ambassador Level Media CIDs
NEXT_PUBLIC_SEQUOIA_2025_JAN=QmYourSequoiaJan2025Hash
NEXT_PUBLIC_SEQUOIA_2025_FEB=QmYourSequoiaFeb2025Hash

# Blossom Ambassador Level Media CIDs
NEXT_PUBLIC_BLOSSOM_2025_JAN=QmYourBlossomJan2025Hash
NEXT_PUBLIC_BLOSSOM_2025_FEB=QmYourBlossomFeb2025Hash

# Seedling Ambassador Level Media CIDs
NEXT_PUBLIC_SEEDLING_2025_JAN=QmYourSeedlingJan2025Hash
NEXT_PUBLIC_SEEDLING_2025_FEB=QmYourSeedlingFeb2025Hash

# Sprout Level Media CIDs
NEXT_PUBLIC_SPROUT_2025_JAN=QmYourSproutJan2025Hash
NEXT_PUBLIC_SPROUT_2025_FEB=QmYourSproutFeb2025Hash

# IPFS Gateway (for displaying NFT media)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Next.js Telemetry (Optional)
# Set to 1 to disable anonymous telemetry collection during builds
# This is automatically set in vercel.json for production builds
# NEXT_TELEMETRY_DISABLED=1

# Neon Database (Serverless Postgres) - REQUIRED for the app to work
# Get this connection string from your Neon project dashboard
# For local development and production:
#   1. Go to https://neon.tech
#   2. Create a new project (free tier available)
#   3. Copy the connection string from the dashboard
#   4. Paste it below
# The connection string format is: postgresql://[user]:[password]@[host]/[database]?sslmode=require
# Without this variable, Discord authentication and all database features will fail!
DATABASE_URL=your_neon_database_connection_string_here
