# Discord OAuth2 Configuration
DISCORD_CLIENT_ID=your_discord_client_id_here
DISCORD_CLIENT_SECRET=your_discord_client_secret_here
DISCORD_REDIRECT_URI=http://localhost:3000/api/auth/discord/callback

# Public Discord Client ID (for frontend)
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id_here

# WalletConnect Project ID (get one at https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# Blockchain Network Selection
# Set NEXT_PUBLIC_NETWORK_ID to the chain ID of the network you want to use
# 3637 = Botanix Mainnet (default)
# 3636 = Botanix Testnet
# IMPORTANT: After changing this value, you MUST restart the dev server (npm run dev)
#            or rebuild (npm run build) for changes to take effect!
NEXT_PUBLIC_NETWORK_ID=3637

# NFT/SBT Configuration - One contract per Discord role
NEXT_PUBLIC_BOTANIST_CONTRACT_ADDRESS=your_botanist_contract_address_here
NEXT_PUBLIC_HYPERION_CONTRACT_ADDRESS=your_hyperion_contract_address_here
NEXT_PUBLIC_SEQUOIA_CONTRACT_ADDRESS=your_sequoia_contract_address_here
NEXT_PUBLIC_BLOSSOM_CONTRACT_ADDRESS=your_blossom_contract_address_here
NEXT_PUBLIC_SEEDLING_CONTRACT_ADDRESS=your_seedling_contract_address_here
NEXT_PUBLIC_SPROUT_CONTRACT_ADDRESS=your_sprout_contract_address_here
BACKEND_PRIVATE_KEY=your_backend_wallet_private_key_here

# IPFS Gateway (for displaying NFT media)
NEXT_PUBLIC_IPFS_GATEWAY=https://ipfs.io/ipfs

# Next.js Telemetry (Optional)
# Set to 1 to disable anonymous telemetry collection during builds
# This is automatically set in vercel.json for production builds
# NEXT_TELEMETRY_DISABLED=1

# Vercel KV (Serverless Redis) - REQUIRED for the app to work
# These are automatically set by Vercel when you create and link a KV database
# For local development, you MUST get these from your Vercel project:
#   1. Go to https://vercel.com/dashboard
#   2. Select your project → Storage tab
#   3. Create a KV database if you haven't already
#   4. Click on your KV database → .env.local tab
#   5. Copy the KV_REST_API_URL and KV_REST_API_TOKEN values
# Without these variables, Discord authentication and all database features will fail!
KV_REST_API_URL=your_kv_rest_api_url_here
KV_REST_API_TOKEN=your_kv_rest_api_token_here

# Alternative: STORAGE1_* prefixed variables (if your storage provider uses this naming)
# If you have STORAGE1_* prefixed variables, you can use them directly without renaming
# The app will automatically map them to the standard KV_* names
# Simply copy and paste these from your storage provider:
# STORAGE1_KV_REST_API_URL=
# STORAGE1_KV_REST_API_TOKEN=
# STORAGE1_KV_REST_API_READ_ONLY_TOKEN=
# STORAGE1_KV_URL=
# STORAGE1_REDIS_URL=

# Debug API Key for protected endpoints (generate a secure random string)
# Use this to protect debug endpoints like /api/debug/browse-kv
# Generate a secure key with: openssl rand -base64 32
# WARNING: Keep this secret and remove debug endpoints in production if not needed
DEBUG_API_KEY=your-secure-api-key-here
